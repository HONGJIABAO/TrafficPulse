# Node / Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local
.oxlint-cache

# Python / Backend
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
backend/.venv/
venv/
backend/venv/
ENV/
env/

# Data Files: Raw & Processed (Never commit large CSV, Parquet, or binary dumps)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
**/data/raw/*
!**/data/raw/.gitkeep
**/data/processed/*
!**/data/processed/.gitkeep

# Large data formats anywhere in repo
*.csv
*.tsv
*.parquet
*.parquet.gzip
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.zip
*.tar.gz
*.7z

# IDE / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
